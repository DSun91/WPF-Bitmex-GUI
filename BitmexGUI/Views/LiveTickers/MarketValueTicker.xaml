<UserControl x:Class="BitmexGUI.Views.MarketValueTicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities">
    <UserControl.Resources>
        <converters:ColorConverterOrderTag x:Key="ColorConverterOrderTag"/>
        <converters:PriceConverterInvMapOrderline x:Key="PriceConverterInvMapOrderline"/>
        <converters:PriceConverterMapOrderline x:Key="PriceConverterMapOrderline"/>
        <converters:PriceFormatConverterOrders x:Key="PriceFormatConverterOrders"/>
        <converters:PriceConverterMapLabel x:Key="PriceConverterMapLabel"/>
        <converters:PriceFormatConverter x:Key="PriceFormatConverter"/>
    </UserControl.Resources>
    <Grid> 
        <Canvas x:Name="TicksCanvasMarket" HorizontalAlignment="Left" Width="65">
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,1500,800" />
            </Canvas.Clip>
            <ItemsControl ItemsSource="{Binding priceStreamViewModel.CurrentClose}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel> 
                <ItemsControl.ItemTemplate>
                    <DataTemplate> 
                        <Canvas> 
                            <Border Canvas.Top="{Binding PriceValue,Converter={StaticResource PriceConverterMapLabel}}"
                                    Canvas.Left="2"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="Black">
                                <Label
                                      x:Name="candleClose"  
                                      Height="40"
                                      Width="95"
                                      HorizontalContentAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontSize = "13"
                                      FontStyle="Italic"
                                      Foreground = "Black"
                                      FontWeight = "Bold">
                                    <TextBlock > 
                                        <Run Text="Market Price:" /> 
                                        <LineBreak />
                                        <Run Text="{Binding PriceValue, Converter={StaticResource PriceFormatConverter} }" /> 
                                    </TextBlock>
                                </Label>
                            </Border>
                           
                            <Line  
                                 x:Name="qwe"
                                 Canvas.Top="0" 
                                 X1="100"  
                                 X2="1400"
                                 Y1="{Binding PriceValue,Converter={StaticResource PriceConverterMapOrderline}}"   
                                 Y2="{Binding PriceValue,Converter={StaticResource PriceConverterMapOrderline}}" 
                                 Stroke="Black"
                                 StrokeThickness="1"
                                 StrokeDashArray="3" />
                            
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </Canvas>

    </Grid>
</UserControl>
