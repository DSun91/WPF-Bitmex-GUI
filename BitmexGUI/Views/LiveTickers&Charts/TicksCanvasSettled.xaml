<UserControl x:Class="BitmexGUI.Views.TicksCanvasSettled"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views"
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities">
    <UserControl.Resources> 
        <converters:PriceConverterMapLabel x:Key="PriceConverterMapLabel"/> 
        <converters:SettledPriceFormatConverter x:Key="SettledPriceFormatConverter"/>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,1500,800"  />
            </Canvas.Clip>
            <ItemsControl ItemsSource="{Binding priceStreamViewModel.SettledPriceData}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Border Canvas.Top="{Binding SettledPriceValue,Converter={StaticResource PriceConverterMapLabel}}"
                                    Canvas.Left="1401" CornerRadius="3" BorderBrush="Purple" BorderThickness="1">
                                <Label
                                 x:Name="BitmxClose"  
                                 Height="40"
                                 Width="93"
                                 HorizontalContentAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize = "13"
                                 FontStyle="Italic"
                                 Foreground = "Purple"
                                 FontWeight = "Bold" 
                                 Background = "Transparent" >
                                    <TextBlock>  
                                        <Run Text="Bitmex Price:" /> 
                                            <LineBreak />
                                         <Run Text="{Binding SettledPriceValue }" />
                                    </TextBlock>
                                </Label>
                            </Border>
                           
                            <Line  
                                x:Name="settledline"
                                Canvas.Top="0" 
                                X1="100"  
                                X2="1400"
                                Y1="{Binding SettledPriceValue, Converter={StaticResource SettledPriceFormatConverter}}"   
                                Y2="{Binding SettledPriceValue, Converter={StaticResource SettledPriceFormatConverter}}" 
                                Stroke="Purple"
                                StrokeThickness="1"
                                StrokeDashArray="2" />
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</UserControl>
