<UserControl x:Class="BitmexGUI.Views.LivePriceChart"
             x:Name="LivePriceChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views" 
             xmlns:viewmodels="clr-namespace:BitmexGUI.ViewModels"
             xmlns:indicators="clr-namespace:BitmexGUI.Views.Indicators"
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>             
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <local:GridView x:Name="GridView" Margin="0,00,0,0" Background="White"/>
        <Canvas x:Name="DrawingCanvas" Background="Transparent" Width="1500" HorizontalAlignment="Center"  Height="450" VerticalAlignment="Center" >
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,1500,450"  />
            </Canvas.Clip>
            <Border BorderBrush="Black" BorderThickness="1" Width="1500" Height="450" Background="Transparent" CornerRadius="10"  >
                <StackPanel>

                    <Canvas x:Name="MainRenderingCanvas" 
                         Margin="100,0,0,0"  
                         HorizontalAlignment="Left"
                         >  
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,-200,1300,700"  />
                        </Canvas.Clip>

                        <local:CandleView  x:Name="CandleView"/>

                        <indicators:IndicatorsCharts  x:Name="Indicators"/>
 
                    </Canvas>

                    <local:MarketValueTicker x:Name="TicksCanvasMarket"/>

                    <local:TicksCanvasSettled x:Name="TicksCanvasSettled"/>

                    <indicators:IndicatorsPannel x:Name="IndicatorsPannel" HorizontalAlignment="Right" Margin="0,0,100,0"/>

                </StackPanel>

            </Border>
            <local:OrderLines x:Name="OrderLinesCanvas" />
            <local:PositionLines x:Name="PositionsLinesCanvas" />
        </Canvas>

    </Grid>
</UserControl>
