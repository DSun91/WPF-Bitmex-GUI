<UserControl x:Class="BitmexGUI.Views.CandleStickChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
             xmlns:local="clr-namespace:BitmexGUI.Views" 
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities"> 
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:PositionConverter  x:Key="PositionConverter"/>
            <converters:PositionConverterCandlestickX  x:Key="PositionConverterCandlestickX"/>
            <converters:ColorConverter   x:Key="ColorConverter"/>
            <converters:CandlesToolTipConverter   x:Key="CandlesToolTipConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Canvas>
            <Line
             x:Name="Wick"
             Canvas.Top="0" 
             X1="{Binding Posx}"  
             X2="{Binding Posx}"
             Y1="{Binding High}"   
             Y2="{Binding Low}" 
             Stroke="Black"
             StrokeThickness="2"/>
            <Rectangle 
             x:Name="Body" 
             Canvas.Top="{Binding Converter={StaticResource PositionConverter}}" 
             Width="{Binding Width}"
             Height="{Binding Height}"  
             Fill= "{Binding Converter={StaticResource ColorConverter}}"
             Panel.ZIndex="0"
             ToolTipService.InitialShowDelay="0"
             ToolTipService.BetweenShowDelay="0">
                <Rectangle.ToolTip>
                    <ToolTip DataContext="{Binding}">
                        <Border Background="Black" CornerRadius="2" Padding="2">
                            <TextBlock Foreground="LightGreen"
                            Text="{Binding PlacementTarget.DataContext,
                               RelativeSource={RelativeSource AncestorType=ToolTip},
                               Converter={StaticResource CandlesToolTipConverter}}"/>
                        </Border>

                    </ToolTip>
                </Rectangle.ToolTip>
                <Canvas.Left>
                    <MultiBinding Converter="{StaticResource PositionConverterCandlestickX}">
                        <Binding Path="Posx" />
                        <Binding Path="Width" />
                    </MultiBinding>
                </Canvas.Left>
            </Rectangle>

        </Canvas>
    </Grid>
</UserControl>
