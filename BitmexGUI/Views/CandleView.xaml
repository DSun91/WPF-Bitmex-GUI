<UserControl x:Class="BitmexGUI.Views.CandleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views" 
             xmlns:viewmodels="clr-namespace:BitmexGUI.ViewModels"  
             mc:Ignorable="d" 
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:PositionConverter  x:Key="PositionConverter"/>
            <converters:PositionConverterCandlestickX  x:Key="PositionConverterCandlestickX"/>
            <converters:ColorConverter   x:Key="ColorConverter"/>
        </ResourceDictionary>
        </UserControl.Resources>
<Grid>
    <ItemsControl ItemsSource="{Binding ScaledPriceData}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Canvas>
                    <Line
                           x:Name="Wick"
                           Canvas.Top="0" 
                           X1="{Binding Posx}"  
                           X2="{Binding Posx}"
                           Y1="{Binding High}"   
                           Y2="{Binding Low}" 
                           Stroke="Black"
                           StrokeThickness="2"/>
                    <Rectangle 
                           x:Name="Body"
                           Canvas.Left="{Binding Converter={StaticResource PositionConverterCandlestickX}}"
                           Canvas.Top="{Binding Converter={StaticResource PositionConverter}}"
                           Width="{Binding Width}"
                           Height="{Binding Height}"  
                           Fill= "{Binding Converter={StaticResource ColorConverter}}"
                           Panel.ZIndex="0"/>
                </Canvas>
            </DataTemplate>

        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Grid> 
</UserControl>