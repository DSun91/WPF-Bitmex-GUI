<UserControl x:Class="BitmexGUI.Views.PositionLines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views"
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities" xmlns:viewmodels="clr-namespace:BitmexGUI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary> 
            <converters:PriceFormatConverterPositions x:Key="PriceFormatConverterPositions"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ItemsControl ItemsSource="{Binding positionsViewModel.PositionsLines}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Canvas>
                        <Border Background="Purple" 
                                Canvas.Top="{Binding AvgEntryPrice,Converter={StaticResource PriceFormatConverterPositions}}" 
                                  CornerRadius="3" Width="170" Height="60"
                                  Canvas.Left="120" >
                        <Label
                        x:Name="BreakEvenPr"   
                        HorizontalContentAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize = "13"
                        FontStyle="Italic"
                        Foreground = "White"
                        FontWeight = "Bold" 
                        Background = "Transparent"> 
                            <TextBlock>
                                <Run Text="Position: "/> 
                                <Run Text="{Binding Symbol}"/>
                                <LineBreak />
                                <Run Text="Delta Break Even: "/>
                                <Run Text="{Binding DeltaFromBreakEven}" />
                                <LineBreak />
                                <Run Text="UnrealisedPnl: "/>
                                <Run Text="{Binding UnrealisedPnl}" />
                            </TextBlock>
                             
                        </Label>
                        </Border>
                        <Line  
                            x:Name="BreakEven"
                            Canvas.Top="0" 
                            X1="102"  
                            X2="1400"
                            Y1="{Binding AvgEntryPrice,Converter={StaticResource PriceFormatConverterPositions}}"   
                            Y2="{Binding AvgEntryPrice,Converter={StaticResource PriceFormatConverterPositions}}" 
                            Stroke="Purple"
                            StrokeThickness="1"/> 
                    </Canvas>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
         
    </Grid>
</UserControl>
