<UserControl x:Class="BitmexGUI.Views.Indicators.IndicatorsPannel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BitmexGUI.ViewModels.Indicators"
             xmlns:local="clr-namespace:BitmexGUI.Views.Indicators"
             mc:Ignorable="d"  >
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SmaViewModel}">
            <local:SMAPannel />
        </DataTemplate>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="1" 
         HorizontalAlignment="Left" Height="Auto"  
         Width="450" CornerRadius="10" Background="AntiqueWhite" Padding="3">
        <Grid> 
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/>  
            </Grid.RowDefinitions>
            <Label Content="Indicator ++" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Grid.Column="0" 
                   Grid.Row="0"
                   FontFamily="Sitka Heading" 
                   FontSize="18"/>
            <ComboBox x:Name="SelectedIndicatorCombobox"
                      HorizontalAlignment="Left" 
                      Grid.Column="1" 
                      Grid.Row="0" 
                      Width="100" 
                      Height="25" 
                      FontFamily="Sitka Heading" 
                      FontSize="14"
                      FontWeight="Bold"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding indicatorsViewModelManager.IndicatorsItems}"
                      HorizontalContentAlignment="Center"
                      SelectedItem="{Binding indicatorsViewModelManager.SelectedIndicator, Mode=TwoWay}"/>
            <Label    Content="Indicator --" 
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Grid.Column="2" 
                      Grid.Row="0"
                      FontFamily="Sitka Heading" 
                      FontSize="18"/>
            <ComboBox x:Name="DeselectedIndicator"
                       HorizontalAlignment="Left" 
                       Grid.Column="3" 
                       Grid.Row="0" 
                       Width="100" 
                       Height="25" 
                       FontFamily="Sitka Heading" 
                       FontSize="14"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       ItemsSource="{Binding indicatorsViewModelManager.IndicatorsInView}" 
                       DisplayMemberPath="Name"
                       SelectedItem="{Binding indicatorsViewModelManager.IndicatorToRemove, Mode=TwoWay}"
                       HorizontalContentAlignment="Center"/>
            <!--SelectionChanged="RemoveIndicatorVm"-->

            <!-- This load the form associated with indicator -->
            <ContentControl x:Name="IndicatorVMContainer" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
               Content="{Binding indicatorsViewModelManager.IndicatorPannelVM, Mode=TwoWay}"  />
        </Grid>
    </Border>
</UserControl>
