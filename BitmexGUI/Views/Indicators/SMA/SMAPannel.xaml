<UserControl x:Class="BitmexGUI.Views.Indicators.SMAPannel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views.Indicators"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"  >
    <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
                <RowDefinition Height="Auto"/> 
            </Grid.RowDefinitions> 
            <Label Content="Period" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Grid.Column="0" 
                   Grid.Row="1"
                   FontFamily="Sitka Heading" 
                   FontSize="18"/>
        <TextBox HorizontalAlignment="Left" 
                     Grid.Column="1" 
                     Grid.Row="1"
                     Width="45" 
                     Height="25" 
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Text="{Binding Period, Mode=TwoWay}"/>
        <Label Content="Color" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Grid.Column="0" 
                    Grid.Row="0"
                    FontFamily="Sitka Heading" 
                    FontSize="18"/>
            <xctk:ColorPicker 
                    Grid.Column="1"
                    Grid.Row="0"
                    Width="100"
                    Height="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    SelectedColor="{Binding Color, Mode=TwoWay}"/>
        
        
        <Button Grid.Row="1"
                    Content="Add"
                    Grid.Column="1" Height="25"
                    Width="50"
                    FontFamily="Sitka Heading" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    VerticalContentAlignment="Center" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" Margin="50,0,0,0"
                    Command="{Binding AddSMA}">
             
        </Button>
    </Grid> 
</UserControl>
