<UserControl x:Class="BitmexGUI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views"
             mc:Ignorable="d"  >
    <Grid>
        <Border BorderThickness="1"  Grid.Row="2" Grid.Column="1" BorderBrush="Black"   CornerRadius="5" >
            <DockPanel  LastChildFill="True"   HorizontalAlignment="Left"  >

                <TextBlock Text="Session Log" Margin="0,0,0,0"
                     Background="Black"
                     Foreground="LawnGreen"
                     FontSize="20"
                     FontWeight="SemiBold"
                     TextAlignment="Center"
                     HorizontalAlignment="Stretch"
                     DockPanel.Dock="Top" >

                </TextBlock>
                <DataGrid  HorizontalAlignment="Left"  Margin="0,0,0,0" Height="410" VerticalAlignment="Top" Width="490" ItemsSource="{Binding HistoricOrdersInfo, UpdateSourceTrigger=PropertyChanged}"  CanUserAddRows="False" AutoGenerateColumns="True"/>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
