<UserControl x:Class="BitmexGUI.Views.OrderLines"
             x:Name="OrderLinesVm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BitmexGUI.Views"
             xmlns:converters="clr-namespace:BitmexGUI.ViewModels.Utilities" xmlns:system="clr-namespace:System;assembly=netstandard"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ColorConverterOrderTag x:Key="ColorConverterOrderTag"/>
            <converters:PriceConverterInvMapOrderline x:Key="PriceConverterInvMapOrderline"/>
            <converters:PriceFormatConverterOrders x:Key="PriceFormatConverterOrders"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid> 
            <ItemsControl ItemsSource="{Binding ordersViewModel.OrdersLines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                        <Border Canvas.Top="{Binding Price,Converter={StaticResource PriceFormatConverterOrders}}"
                                Canvas.Left="1250" CornerRadius="3"  
                                Background = "{Binding Converter={StaticResource ColorConverterOrderTag}}"
                                >
                            <Label
                                   x:Name="PriceTag"
                                   Tag="{Binding OrderID}" 
                                   Height="45"
                                   Width="150"
                                   HorizontalContentAlignment="Left"
                                   VerticalAlignment="Top"
                                   FontSize = "14"
                                   FontStyle="Italic" 
                                   Foreground = "Black"
                                   FontWeight = "Bold"  
                                   
                                   MouseRightButtonDown="OrderTag_MouseRightButtonDown"
                                   MouseMove = "OrderTag_MouseMove"
                                   MouseRightButtonUp="OrderTag_MouseRightButtonUp"  >
                                <TextBlock>
                                    <Run Text="{Binding Side}"/>
                                    <Run Text=" Order "/>
                                 <LineBreak/>
                                <Run Text=" Entry Price: "/>
                                <Run Text="{Binding Price}" />
                                </TextBlock>
                            </Label>
                        </Border>
                        <Border Canvas.Top="{Binding Price,Converter={StaticResource PriceFormatConverterOrders}}"
                                Canvas.Left="1383" CornerRadius="5"> 
                            <Button
                                x:Name="CancelOrder"
                                Content="X"
                                Tag="{Binding OrderID}" 
                                Width="15"
                                Height="15"
                                FontSize="8" 
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                BorderBrush="Black"
                                Background="Transparent" 
                                Command="{Binding DataContext.ordersViewModel.CancelOrderCommand, ElementName=OrderLinesVm}"
                                CommandParameter="{Binding OrderID}" >
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="Black"/>
                                             </Trigger>
                                         </Style.Triggers>
                                    </Style>
                                </Button.Style> 
                            </Button>
                        </Border>
                            
                        <Line  
                             x:Name="OrderLine"
                             Canvas.Top="0" 
                             X1="102"  
                             X2="1400"
                             Y1="{Binding Price,Converter={StaticResource PriceFormatConverterOrders}}"   
                             Y2="{Binding Price,Converter={StaticResource PriceFormatConverterOrders}}" 
                             Stroke="{Binding Converter={StaticResource ColorConverterOrderTag}}"
                             StrokeThickness="2"
                             StrokeDashArray="2"
                             />

                    </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl> 
    </Grid>
</UserControl>
